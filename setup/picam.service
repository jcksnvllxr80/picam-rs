[Unit]
Description=picam-rs astrophotography kiosk
After=graphical.target systemd-logind.service

[Service]
User=pi
Group=pi
PAMName=login
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=journal
StandardError=journal

Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=HOME=/home/pi

# cage creates a Wayland compositor and runs picam fullscreen inside it.
# -s = launch app immediately, no idle-inhibit overhead.
ExecStart=/usr/bin/cage -s -- /usr/bin/picam

Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
