[Unit]
Description=PiCam Rust kiosk
After=graphical.target systemd-logind.service

[Service]
User=pi
Group=pi
PAMName=login
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=journal
StandardError=journal

Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=HOME=/home/pi

# cage creates a Wayland compositor and runs our app fullscreen inside it.
# -s = launch app immediately, no idle-inhibit overhead
ExecStart=/usr/bin/cage -s -- /home/pi/picam-rs/target/release/picam

Restart=on-failure
RestartSec=3

# Allow sudo for shutdown/reboot without password
# (add 'pi ALL=(ALL) NOPASSWD: /sbin/shutdown, /sbin/reboot' in /etc/sudoers.d/picam)

[Install]
WantedBy=multi-user.target
