import { ScrollView } from "std-widgets.slint";

export enum Page { Viewfinder, Settings, Gallery, Power }
export enum CaptureMode { Photo, Video, Timelapse }
export enum TlState { Idle, Running, Rendering }
export enum SettingsTab { Capture, Image, Advanced, Stream, General }

export struct GalleryItem {
    path: string,
    name: string,
    is-video: bool,
}

// ── Screen-sleep idle tracker ─────────────────────────────────────────────────
// `ms-since-touch` increments every second via a Timer in AppWindow. Any
// pointer-down event (caught by a back-layer TouchArea) calls Idle.touch()
// which resets it. When it exceeds `sleep-after-ms` (set from the General-tab
// timeout idx), the AppWindow shows a fullscreen black overlay; any touch on
// it dismisses sleep. `sleep-after-ms == 0` disables the feature.
global Idle {
    in-out property <int>  ms-since-touch:  0;
    in-out property <int>  sleep-after-ms:  0;
    out property    <bool> sleeping:        sleep-after-ms > 0 && ms-since-touch >= sleep-after-ms;
    public function touch() {
        ms-since-touch = 0;
    }
}

// ── Shared colours ────────────────────────────────────────────────────────────
// Astro theme: monochrome red palette tuned for telescope eyepiece use.
// Red light (>600nm) minimally activates rod cells, so the UI never wrecks
// dark adaptation. Hierarchy comes from brightness, not hue. Never use
// white, blue, or green anywhere — all of those destroy night vision.
global Theme {
    out property <color> bg:       #000000;             // pure black, no stray light
    out property <color> surface:  #1a0606;             // very dim red-tinted button bg
    out property <color> overlay:  rgba(20,0,0,0.75);   // red-tinted overlays
    out property <color> accent:   #ff3030;             // bright red (record / destructive)
    out property <color> warn:     #c04020;             // dimmer red (warnings, timelapse)
    out property <color> info:     #802020;             // dim red (selected / info state)
    out property <color> text:     #d04040;             // readable dim red
    out property <color> dim:      #803030;             // hint-level red
    out property <length> touch:   48px;
}

// ── Small icon-text button used in nav bar ────────────────────────────────────
// Icon is the dominant element — large glyph centered with the label below.
component NavBtn inherits TouchArea {
    in property <string> icon;
    in property <string> label;
    in property <bool>   active: false;

    width: 80px;
    height: 60px;
    mouse-cursor: none;

    Rectangle {
        background: active ? Theme.surface : transparent;
        border-radius: 6px;
        VerticalLayout {
            alignment: center;
            spacing: 0px;
            Text {
                text: icon;
                color: active ? Theme.accent : Theme.text;
                font-size: 28px;
                horizontal-alignment: center;
            }
            Text {
                text: label;
                color: active ? Theme.text : Theme.dim;
                font-size: 10px;
                font-weight: active ? 700 : 400;
                horizontal-alignment: center;
            }
        }
    }
}

// ── Generic flat button (dark surface) ───────────────────────────────────────
component FlatBtn inherits TouchArea {
    in property <string> label;
    in property <bool> active: false;
    in property <color> active-color: Theme.accent;
    in property <length> btn-font-size: 14px;

    width: 90px;
    height: Theme.touch;
    mouse-cursor: none;

    Rectangle {
        border-radius: 6px;
        background: active ? active-color : Theme.surface;
        Text {
            text: label;
            color: Theme.text;
            font-size: btn-font-size;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

// ── Labelled row for settings ─────────────────────────────────────────────────
component SettingRow inherits Rectangle {
    in property <string> label;
    background: transparent;
    height: 60px;

    Text {
        x: 10px;
        y: 0;
        height: parent.height;
        text: label;
        color: Theme.text;
        font-size: 14px;
        vertical-alignment: center;
    }

    @children
}

// ─────────────────────────────────────────────────────────────────────────────
// Main window
// ─────────────────────────────────────────────────────────────────────────────
export component AppWindow inherits Window {
    title: "PiCam";
    width: 800px;
    height: 480px;
    background: Theme.bg;
    no-frame: true;

    // ── Camera state ──────────────────────────────────────────────────────────
    in property <image>  preview-frame;
    in property <bool>   recording:     false;
    in property <string> rec-duration:  "00:00";
    in property <bool>   capturing:     false;

    // ── Navigation ────────────────────────────────────────────────────────────
    in-out property <Page>        current-page:   Page.Viewfinder;
    in-out property <CaptureMode> capture-mode:   CaptureMode.Photo;

    // ── Settings ──────────────────────────────────────────────────────────────
    in-out property <int>   iso-idx:    0;
    in-out property <int>   shutter-idx:0;
    in-out property <int>   awb-idx:    0;
    in-out property <float> ev:         0.0;
    in-out property <float> contrast:   1.0;
    in-out property <float> saturation: 1.0;
    in-out property <float> sharpness:  1.0;
    in-out property <float> brightness: 0.0;
    in-out property <float> zoom:       1.0;

    // ── Timelapse ─────────────────────────────────────────────────────────────
    in-out property <TlState> tl-state:     TlState.Idle;
    in-out property <int>     tl-interval:  10;   // seconds between frames
    in-out property <int>     tl-duration:  60;   // total seconds
    in property    <int>      tl-frames:    0;
    in property    <string>   tl-status:    "";

    // ── Gallery ───────────────────────────────────────────────────────────────
    in property <[GalleryItem]> gallery-items: [];
    in-out property <int>       gallery-sel:   -1;
    in property    <image>      gallery-preview-image;

    // ── Advanced ──────────────────────────────────────────────────────────────
    in-out property <bool>        stream-enabled: true;
    in-out property <int>         photo-res-idx:  0;   // 0=12MP .. 3=FHD
    in-out property <int>         video-res-idx:  0;   // 0=1080p .. 2=480p
    in-out property <int>         tl-res-idx:     0;   // 0=3MP .. 2=720p
    in-out property <bool>        raw-enabled:    false;
    in-out property <SettingsTab> settings-tab:   SettingsTab.Capture;

    // ── General ───────────────────────────────────────────────────────────────
    in-out property <int>  self-timer-idx: 0;        // 0=off, 1=2s, 2=5s, 3=10s
    in-out property <int>  burst-count-idx: 0;       // 0=1, 1=3, 2=5, 3=10
    in-out property <bool> last-shot-enabled: true;
    in-out property <int>  sleep-timeout-idx: 0;     // 0=off, 1=30s, 2=1min, 3=5min, 4=10min, 5=30min
    in property    <string> free-space-str: "—";

    // Bridge the idx-based UI control to the Idle global's ms threshold.
    function apply-sleep-idx() {
        Idle.sleep-after-ms =
            sleep-timeout-idx == 1 ?   30 * 1000 :
            sleep-timeout-idx == 2 ?   60 * 1000 :
            sleep-timeout-idx == 3 ?  5 * 60 * 1000 :
            sleep-timeout-idx == 4 ? 10 * 60 * 1000 :
            sleep-timeout-idx == 5 ? 30 * 60 * 1000 :
            0;
        Idle.ms-since-touch = 0;
    }
    init => { apply-sleep-idx(); }
    changed sleep-timeout-idx => { apply-sleep-idx(); }

    // ── Streaming (Advanced tab — values come from config.toml) ───────────────
    in-out property <int>    stream-port: 8080;         // read-only display
    in-out property <string> push-url:    "";           // read-only display
    in-out property <bool>   local-stream-active: false;
    in-out property <bool>   push-stream-active:  false;

    // Last-shot review state (managed by Rust, displayed when enabled)
    in property    <bool>  show-last-shot: false;
    in property    <image> last-shot-image;
    // Self-timer countdown (Rust sets to N → 1 → 0; UI shows when > 0)
    in property    <int>   timer-countdown: 0;
    // Burst progress (e.g. "3 / 5"); empty when not bursting
    in property    <string> burst-status: "";

    // ── Callbacks ─────────────────────────────────────────────────────────────
    callback capture-photo();
    callback start-recording();
    callback stop-recording();
    callback start-timelapse();
    callback stop-timelapse();
    callback render-timelapse();
    callback delete-item(int);
    callback select-gallery-item(int);
    callback play-video(string);
    callback refresh-gallery();
    callback toggle-stream(bool);
    callback toggle-local-stream(bool);
    callback toggle-push-stream(bool);
    callback reload-config();
    callback shutdown-system();
    callback reboot-system();
    callback restart-app();
    callback sleeping-changed(bool);
    callback apply-remote-settings();   // poked when /control posts a setting update

    // Mirror Idle.sleeping into an out property so Rust can fire a callback on
    // change (used to drive the backlight off when the screen sleeps).
    out property <bool> sleeping: Idle.sleeping;
    changed sleeping => { root.sleeping-changed(self.sleeping); }

    // ── Idle/sleep machinery ──────────────────────────────────────────────────
    // Tick the idle counter; pointer-event on the back-layer touch capturer
    // resets it via Idle.touch(). When Idle.sleeping flips true, a fullscreen
    // black overlay is shown over everything else.
    Timer {
        interval: 1s;
        running: Idle.sleep-after-ms > 0 && !Idle.sleeping;
        triggered => { Idle.ms-since-touch += 1000; }
    }
    // Back-layer pointer listener: fires for any pointer event in the window,
    // even if a foreground TouchArea also handles it. This is how we detect
    // "user touched something" without instrumenting every individual button.
    back-touch := TouchArea {
        x: 0; y: 0; width: 800px; height: 480px;
        mouse-cursor: none;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) { Idle.touch(); }
        }
    }

    // ── Pages ─────────────────────────────────────────────────────────────────

    // ·· Viewfinder ··
    if current-page == Page.Viewfinder: Rectangle {
        x: 0; y: 0; width: 800px; height: 420px;
        background: #000000;
        clip: true;

        // Live preview
        Image {
            x: 0; y: 0;
            width: 800px; height: 420px;
            source: root.preview-frame;
            image-fit: contain;
        }

        // "Preview Disabled" overlay (covers the dark preview area)
        if !root.stream-enabled: Rectangle {
            x: 0; y: 0; width: 800px; height: 420px;
            background: Theme.bg;
            VerticalLayout {
                alignment: center; spacing: 12px;
                Text {
                    text: "● Preview Disabled";
                    color: Theme.text; font-size: 22px; font-weight: 700;
                    horizontal-alignment: center;
                }
                Text {
                    text: "Re-enable in Settings → Advanced → Live Preview";
                    color: Theme.dim; font-size: 13px;
                    horizontal-alignment: center;
                }
            }
        }

        // Recording badge
        if root.recording: Rectangle {
            x: 10px; y: 10px;
            width: 110px; height: 32px;
            background: Theme.accent;
            border-radius: 4px;
            Text {
                text: "● REC " + root.rec-duration;
                color: Theme.text;
                font-size: 13px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        // Timelapse badge
        if root.tl-state == TlState.Running || root.tl-state == TlState.Rendering: Rectangle {
            x: 10px; y: root.recording ? 50px : 10px;
            width: 160px; height: 32px;
            background: Theme.warn;
            border-radius: 4px;
            Text {
                text: root.tl-state == TlState.Rendering ? "Rendering…" : "TL " + root.tl-frames + " frames";
                color: Theme.text;
                font-size: 13px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        // Capture flash — DIM RED, not white. White destroys dark adaptation.
        if root.capturing: Rectangle {
            background: #2a0000;
            opacity: 0.5;
        }

        // Self-timer countdown overlay
        if root.timer-countdown > 0: Rectangle {
            x: 0; y: 0; width: 800px; height: 420px;
            background: rgba(0,0,0,0.4);
            Text {
                text: root.timer-countdown;
                color: Theme.accent;
                font-size: 200px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        // Burst progress badge
        if root.burst-status != "": Rectangle {
            x: 600px; y: 10px;
            width: 180px; height: 32px;
            background: Theme.overlay;
            border-radius: 4px;
            Text {
                text: "Burst " + root.burst-status;
                color: Theme.text; font-size: 14px; font-weight: 700;
                horizontal-alignment: center; vertical-alignment: center;
            }
        }

        // Last-shot review overlay
        if root.show-last-shot: Rectangle {
            x: 600px; y: 50px;
            width: 190px; height: 130px;
            background: Theme.bg;
            border-width: 2px;
            border-color: Theme.text;
            border-radius: 6px;
            Image {
                x: 4px; y: 4px;
                width: 182px; height: 122px;
                source: root.last-shot-image;
                image-fit: contain;
            }
        }

        // Mode selector (left column overlay)
        Rectangle {
            x: 0; y: 155px;
            width: 80px; height: 110px;
            background: Theme.overlay;
            border-radius: 6px;

            VerticalLayout {
                spacing: 4px;
                padding: 4px;

                FlatBtn {
                    label: "Photo";
                    active: root.capture-mode == CaptureMode.Photo;
                    active-color: Theme.info;
                    width: 72px;
                    clicked => { root.capture-mode = CaptureMode.Photo; }
                }
                FlatBtn {
                    label: "Video";
                    active: root.capture-mode == CaptureMode.Video;
                    active-color: Theme.info;
                    width: 72px;
                    clicked => { root.capture-mode = CaptureMode.Video; }
                }
                FlatBtn {
                    label: "T-Lapse";
                    active: root.capture-mode == CaptureMode.Timelapse;
                    active-color: Theme.info;
                    width: 72px;
                    clicked => { root.capture-mode = CaptureMode.Timelapse; }
                }
            }
        }

        // Capture button (right side overlay)
        // Recording (active) is bright red; idle states are dim red — brightness
        // signals state, so cold fingers can read it at a glance.
        capture-ta := TouchArea {
            mouse-cursor: none;
            x: 708px; y: 160px;
            width: 84px; height: 100px;

            Rectangle {
                border-radius: 42px;
                background: capture-ta.pressed ? Theme.accent :
                            root.capture-mode == CaptureMode.Video    ? (root.recording ? Theme.accent : Theme.info) :
                            root.capture-mode == CaptureMode.Timelapse ? (root.tl-state == TlState.Running ? Theme.accent : Theme.warn) :
                            Theme.info;
                width: 76px; height: 76px;
                x: 4px; y: 12px;
                border-width: 2px;
                border-color: Theme.text;

                Text {
                    visible: root.capture-mode == CaptureMode.Video;
                    text: root.recording ? "■" : "●";
                    color: Theme.text;
                    font-size: 28px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                Text {
                    visible: root.capture-mode == CaptureMode.Timelapse;
                    text: root.tl-state == TlState.Running ? "■" : "▶";
                    color: Theme.text;
                    font-size: 22px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            clicked => {
                if root.capture-mode == CaptureMode.Photo {
                    root.capture-photo();
                } else if root.capture-mode == CaptureMode.Video {
                    if root.recording { root.stop-recording(); } else { root.start-recording(); }
                } else {
                    if root.tl-state == TlState.Running { root.stop-timelapse(); } else { root.start-timelapse(); }
                }
            }
        }

        // Timelapse render button (appears when TL idle with frames)
        if root.capture-mode == CaptureMode.Timelapse && root.tl-state == TlState.Idle && root.tl-frames > 0: TouchArea {
                mouse-cursor: none;
            x: 688px; y: 270px;
            width: 104px; height: 48px;
            Rectangle {
                background: Theme.warn;
                border-radius: 6px;
                Text {
                    text: "Render MP4";
                    color: Theme.text;
                    font-size: 13px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
            clicked => { root.render-timelapse(); }
        }

        // Timelapse config (interval / duration) - bottom overlay when TL mode idle
        // Logarithmic-ish steps tuned for astro: short intervals for planetary
        // capture, hour-scale durations for deep-sky sessions.
        if root.capture-mode == CaptureMode.Timelapse && root.tl-state == TlState.Idle: Rectangle {
            x: 85px; y: 354px;
            width: 615px; height: 60px;
            background: Theme.overlay;
            border-radius: 6px;

            HorizontalLayout {
                spacing: 6px;
                padding: 6px;

                Text { text: "Int:"; color: Theme.dim; font-size: 13px; vertical-alignment: center; }
                TouchArea {
                    mouse-cursor: none;
                    width: 48px; height: 48px;
                    Rectangle { background: Theme.surface; border-radius: 6px;
                        Text { text: "−"; color: Theme.text; font-size: 20px;
                               horizontal-alignment: center; vertical-alignment: center; } }
                    clicked => {
                        if      root.tl-interval > 60 { root.tl-interval = 60;  }
                        else if root.tl-interval > 30 { root.tl-interval = 30;  }
                        else if root.tl-interval > 10 { root.tl-interval = 10;  }
                        else if root.tl-interval > 5  { root.tl-interval = 5;   }
                        else if root.tl-interval > 2  { root.tl-interval = 2;   }
                        else if root.tl-interval > 1  { root.tl-interval = 1;   }
                    }
                }
                Text { text: root.tl-interval + "s"; color: Theme.text; font-size: 14px;
                       vertical-alignment: center; width: 44px; horizontal-alignment: center; }
                TouchArea {
                    mouse-cursor: none;
                    width: 48px; height: 48px;
                    Rectangle { background: Theme.surface; border-radius: 6px;
                        Text { text: "+"; color: Theme.text; font-size: 20px;
                               horizontal-alignment: center; vertical-alignment: center; } }
                    clicked => {
                        if      root.tl-interval < 1   { root.tl-interval = 1;   }
                        else if root.tl-interval < 2   { root.tl-interval = 2;   }
                        else if root.tl-interval < 5   { root.tl-interval = 5;   }
                        else if root.tl-interval < 10  { root.tl-interval = 10;  }
                        else if root.tl-interval < 30  { root.tl-interval = 30;  }
                        else if root.tl-interval < 60  { root.tl-interval = 60;  }
                        else if root.tl-interval < 120 { root.tl-interval = 120; }
                        else if root.tl-interval < 300 { root.tl-interval = 300; }
                    }
                }

                Rectangle { width: 12px; }

                Text { text: "Dur:"; color: Theme.dim; font-size: 13px; vertical-alignment: center; }
                TouchArea {
                    mouse-cursor: none;
                    width: 48px; height: 48px;
                    Rectangle { background: Theme.surface; border-radius: 6px;
                        Text { text: "−"; color: Theme.text; font-size: 20px;
                               horizontal-alignment: center; vertical-alignment: center; } }
                    clicked => {
                        if      root.tl-duration > 3600 { root.tl-duration = 3600; }
                        else if root.tl-duration > 1800 { root.tl-duration = 1800; }
                        else if root.tl-duration > 600  { root.tl-duration = 600;  }
                        else if root.tl-duration > 300  { root.tl-duration = 300;  }
                        else if root.tl-duration > 60   { root.tl-duration = 60;   }
                        else if root.tl-duration > 30   { root.tl-duration = 30;   }
                    }
                }
                Text {
                    text: root.tl-duration >= 3600 ? (root.tl-duration / 3600) + "h" :
                          root.tl-duration >= 60   ? (root.tl-duration / 60) + "m" :
                                                     root.tl-duration + "s";
                    color: Theme.text; font-size: 14px;
                    vertical-alignment: center; width: 56px; horizontal-alignment: center;
                }
                TouchArea {
                    mouse-cursor: none;
                    width: 48px; height: 48px;
                    Rectangle { background: Theme.surface; border-radius: 6px;
                        Text { text: "+"; color: Theme.text; font-size: 20px;
                               horizontal-alignment: center; vertical-alignment: center; } }
                    clicked => {
                        if      root.tl-duration < 30   { root.tl-duration = 30;   }
                        else if root.tl-duration < 60   { root.tl-duration = 60;   }
                        else if root.tl-duration < 300  { root.tl-duration = 300;  }
                        else if root.tl-duration < 600  { root.tl-duration = 600;  }
                        else if root.tl-duration < 1800 { root.tl-duration = 1800; }
                        else if root.tl-duration < 3600 { root.tl-duration = 3600; }
                        else if root.tl-duration < 7200 { root.tl-duration = 7200; }
                    }
                }
            }
        }
    }

    // ·· Settings ··
    if current-page == Page.Settings: Rectangle {
        x: 0; y: 0; width: 800px; height: 420px;
        background: Theme.bg;

        // Tab bar — Capture / Image / Advanced
        Rectangle {
            x: 0; y: 0; width: 800px; height: 52px;
            background: #0a0000;

            HorizontalLayout {
                spacing: 0; padding-left: 8px; padding-right: 8px;
                padding-top: 6px; padding-bottom: 6px;

                TouchArea {
                    mouse-cursor: none;
                    Rectangle {
                        background: root.settings-tab == SettingsTab.Capture ? Theme.info : transparent;
                        border-radius: 6px;
                        Text {
                            text: "Capture";
                            color: Theme.text;
                            font-size: 14px;
                            font-weight: root.settings-tab == SettingsTab.Capture ? 700 : 400;
                            horizontal-alignment: center; vertical-alignment: center;
                        }
                    }
                    clicked => { root.settings-tab = SettingsTab.Capture; }
                }
                TouchArea {
                    mouse-cursor: none;
                    Rectangle {
                        background: root.settings-tab == SettingsTab.Image ? Theme.info : transparent;
                        border-radius: 6px;
                        Text {
                            text: "Image";
                            color: Theme.text;
                            font-size: 14px;
                            font-weight: root.settings-tab == SettingsTab.Image ? 700 : 400;
                            horizontal-alignment: center; vertical-alignment: center;
                        }
                    }
                    clicked => { root.settings-tab = SettingsTab.Image; }
                }
                TouchArea {
                    mouse-cursor: none;
                    Rectangle {
                        background: root.settings-tab == SettingsTab.Advanced ? Theme.info : transparent;
                        border-radius: 6px;
                        Text {
                            text: "Advanced";
                            color: Theme.text;
                            font-size: 14px;
                            font-weight: root.settings-tab == SettingsTab.Advanced ? 700 : 400;
                            horizontal-alignment: center; vertical-alignment: center;
                        }
                    }
                    clicked => { root.settings-tab = SettingsTab.Advanced; }
                }
                TouchArea {
                    mouse-cursor: none;
                    Rectangle {
                        background: root.settings-tab == SettingsTab.Stream ? Theme.info : transparent;
                        border-radius: 6px;
                        Text {
                            text: "Stream";
                            color: Theme.text;
                            font-size: 14px;
                            font-weight: root.settings-tab == SettingsTab.Stream ? 700 : 400;
                            horizontal-alignment: center; vertical-alignment: center;
                        }
                    }
                    clicked => { root.settings-tab = SettingsTab.Stream; }
                }
                TouchArea {
                    mouse-cursor: none;
                    Rectangle {
                        background: root.settings-tab == SettingsTab.General ? Theme.info : transparent;
                        border-radius: 6px;
                        Text {
                            text: "General";
                            color: Theme.text;
                            font-size: 14px;
                            font-weight: root.settings-tab == SettingsTab.General ? 700 : 400;
                            horizontal-alignment: center; vertical-alignment: center;
                        }
                    }
                    clicked => { root.settings-tab = SettingsTab.General; }
                }
            }
        }

        // Tab content — only one is visible at a time
        if root.settings-tab == SettingsTab.Capture: Rectangle {
            x: 0; y: 56px; width: 800px; height: 364px;
            background: transparent;

            VerticalLayout {
                x: 0; width: 800px;
                spacing: 4px;
                padding-left: 10px; padding-right: 10px;

                // ISO
                SettingRow { label: "ISO";
                    HorizontalLayout {
                        x: 120px; spacing: 4px; padding: 4px;
                        for lbl[i] in ["Auto","100","200","400","800","1600","3200"]: FlatBtn {
                            label: lbl; active: root.iso-idx == i; width: 68px;
                            active-color: Theme.info;
                            clicked => { root.iso-idx = i; }
                        }
                    }
                }

                // Shutter — short exposures (row 1)
                SettingRow { label: "Shutter";
                    HorizontalLayout {
                        x: 120px; spacing: 4px; padding: 4px;
                        for lbl[i] in ["Auto","1/4000","1/1000","1/500","1/250","1/60","1/30","1s"]: FlatBtn {
                            label: lbl; active: root.shutter-idx == i; width: 70px;
                            active-color: Theme.info;
                            clicked => { root.shutter-idx = i; }
                        }
                    }
                }

                // Shutter — long exposures (row 2, indices 8-12)
                SettingRow { label: "(long)";
                    HorizontalLayout {
                        x: 120px; spacing: 4px; padding: 4px;
                        for lbl[j] in ["5s","15s","30s","60s","120s"]: FlatBtn {
                            label: lbl; active: root.shutter-idx == j + 8; width: 70px;
                            active-color: Theme.info;
                            clicked => { root.shutter-idx = j + 8; }
                        }
                    }
                }

                // AWB
                SettingRow { label: "AWB";
                    HorizontalLayout {
                        x: 120px; spacing: 4px; padding: 4px;
                        for lbl[i] in ["Auto","Incan","Tungst","Fluor","Indoor","Day","Cloudy"]: FlatBtn {
                            label: lbl; active: root.awb-idx == i; width: 72px;
                            active-color: Theme.info;
                            clicked => { root.awb-idx = i; }
                        }
                    }
                }

                // EV
                SettingRow { label: "EV  " + root.ev;
                    HorizontalLayout {
                        x: 120px; spacing: 6px; padding: 4px;
                        for v in [-2.0, -1.0, -0.5, 0.0, 0.5, 1.0, 2.0]: FlatBtn {
                            label: v >= 0 ? "+" + v : "" + v;
                            active: abs(root.ev - v) < 0.01;
                            active-color: Theme.info;
                            width: 60px;
                            clicked => { root.ev = v; }
                        }
                    }
                }

                // Zoom
                SettingRow { label: "Zoom  " + root.zoom + "×";
                    HorizontalLayout {
                        x: 120px; spacing: 6px; padding: 4px;
                        for v in [1.0, 1.5, 2.0, 3.0, 4.0]: FlatBtn {
                            label: v + "×";
                            active: abs(root.zoom - v) < 0.01;
                            active-color: Theme.info;
                            width: 64px;
                            clicked => { root.zoom = v; }
                        }
                    }
                }
            }
        }

        // ── Image tab ──
        if root.settings-tab == SettingsTab.Image: Rectangle {
            x: 0; y: 56px; width: 800px; height: 364px;
            background: transparent;

            VerticalLayout {
                x: 0; width: 800px;
                spacing: 4px;
                padding-left: 10px; padding-right: 10px;

                SettingRow { label: "Contrast  " + root.contrast;
                    HorizontalLayout {
                        x: 180px; spacing: 6px; padding: 4px;
                        for v in [0.5, 0.75, 1.0, 1.25, 1.5, 2.0]: FlatBtn {
                            label: "" + v; active: abs(root.contrast - v) < 0.01;
                            active-color: Theme.info; width: 60px;
                            clicked => { root.contrast = v; }
                        }
                    }
                }

                SettingRow { label: "Saturation  " + root.saturation;
                    HorizontalLayout {
                        x: 180px; spacing: 6px; padding: 4px;
                        for v in [0.0, 0.5, 1.0, 1.5, 2.0]: FlatBtn {
                            label: "" + v; active: abs(root.saturation - v) < 0.01;
                            active-color: Theme.info; width: 70px;
                            clicked => { root.saturation = v; }
                        }
                    }
                }

                SettingRow { label: "Sharpness  " + root.sharpness;
                    HorizontalLayout {
                        x: 180px; spacing: 6px; padding: 4px;
                        for v in [0.0, 0.5, 1.0, 1.5, 2.0]: FlatBtn {
                            label: "" + v; active: abs(root.sharpness - v) < 0.01;
                            active-color: Theme.info; width: 70px;
                            clicked => { root.sharpness = v; }
                        }
                    }
                }

                SettingRow { label: "Brightness  " + root.brightness;
                    HorizontalLayout {
                        x: 180px; spacing: 6px; padding: 4px;
                        for v in [-0.5, -0.25, 0.0, 0.25, 0.5]: FlatBtn {
                            label: v >= 0 ? "+" + v : "" + v;
                            active: abs(root.brightness - v) < 0.01;
                            active-color: Theme.info; width: 80px;
                            clicked => { root.brightness = v; }
                        }
                    }
                }
            }
        }

        // ── Advanced tab ──
        if root.settings-tab == SettingsTab.Advanced: Rectangle {
            x: 0; y: 56px; width: 800px; height: 364px;
            background: transparent;

            VerticalLayout {
                x: 0; width: 800px;
                spacing: 4px;
                padding-left: 10px; padding-right: 10px;

                // Live preview toggle
                SettingRow { label: "Live Preview";
                    HorizontalLayout {
                        x: 180px; spacing: 6px; padding: 4px;
                        FlatBtn {
                            label: "ON"; active: root.stream-enabled;
                            active-color: Theme.info; width: 80px;
                            clicked => {
                                root.stream-enabled = true;
                                root.toggle-stream(true);
                            }
                        }
                        FlatBtn {
                            label: "OFF"; active: !root.stream-enabled;
                            active-color: Theme.warn; width: 80px;
                            clicked => {
                                root.stream-enabled = false;
                                root.toggle-stream(false);
                            }
                        }
                    }
                }

                // Photo resolution
                SettingRow { label: "Photo Res";
                    HorizontalLayout {
                        x: 180px; spacing: 6px; padding: 4px;
                        for lbl[i] in ["12MP", "8MP", "5MP", "FHD"]: FlatBtn {
                            label: lbl; active: root.photo-res-idx == i; width: 80px;
                            active-color: Theme.info;
                            clicked => { root.photo-res-idx = i; }
                        }
                    }
                }

                // Video resolution (ffmpeg scales output; camera always 1080p)
                SettingRow { label: "Video Res";
                    HorizontalLayout {
                        x: 180px; spacing: 6px; padding: 4px;
                        for lbl[i] in ["1080p", "720p", "480p"]: FlatBtn {
                            label: lbl; active: root.video-res-idx == i; width: 90px;
                            active-color: Theme.info;
                            clicked => { root.video-res-idx = i; }
                        }
                    }
                }

                // Timelapse resolution
                SettingRow { label: "TL Res";
                    HorizontalLayout {
                        x: 180px; spacing: 6px; padding: 4px;
                        for lbl[i] in ["3MP", "FHD", "720p"]: FlatBtn {
                            label: lbl; active: root.tl-res-idx == i; width: 90px;
                            active-color: Theme.info;
                            clicked => { root.tl-res-idx = i; }
                        }
                    }
                }

                // RAW DNG capture (saves alongside JPEG)
                SettingRow { label: "RAW (DNG)";
                    HorizontalLayout {
                        x: 180px; spacing: 6px; padding: 4px;
                        FlatBtn {
                            label: "OFF"; active: !root.raw-enabled;
                            active-color: Theme.info; width: 80px;
                            clicked => { root.raw-enabled = false; }
                        }
                        FlatBtn {
                            label: "ON"; active: root.raw-enabled;
                            active-color: Theme.warn; width: 80px;
                            clicked => { root.raw-enabled = true; }
                        }
                    }
                }
            }
        }

        // ── Stream tab ──
        if root.settings-tab == SettingsTab.Stream: Rectangle {
            x: 0; y: 56px; width: 800px; height: 364px;
            background: transparent;

            VerticalLayout {
                x: 0; width: 800px;
                spacing: 4px;
                padding-left: 10px; padding-right: 10px;

                // Local MJPEG HTTP server. Port comes from config.toml.
                SettingRow { label: "HTTP Stream";
                    HorizontalLayout {
                        x: 180px; spacing: 6px; padding: 4px;
                        FlatBtn {
                            label: root.local-stream-active ? "STOP" : "START";
                            active: root.local-stream-active;
                            active-color: Theme.accent; width: 90px;
                            clicked => { root.toggle-local-stream(!root.local-stream-active); }
                        }
                        Text {
                            text: ":" + root.stream-port;
                            color: Theme.text; font-size: 14px; width: 80px;
                            vertical-alignment: center;
                        }
                        Text {
                            text: root.local-stream-active ? "● live" : "○ idle";
                            color: root.local-stream-active ? Theme.accent : Theme.dim;
                            font-size: 13px;
                            vertical-alignment: center;
                        }
                    }
                }

                // Push stream to a URL (RTMP / SRT / MPEG-TS).
                SettingRow { label: "Push URL";
                    HorizontalLayout {
                        x: 180px; spacing: 6px; padding: 4px;
                        FlatBtn {
                            label: root.push-stream-active ? "STOP" : "START";
                            active: root.push-stream-active;
                            active-color: Theme.accent; width: 90px;
                            clicked => { root.toggle-push-stream(!root.push-stream-active); }
                        }
                        Text {
                            text: root.push-url == "" ? "(none — set in config)" : root.push-url;
                            color: root.push-url == "" ? Theme.dim : Theme.text;
                            font-size: 12px;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                    }
                }

                // Reload config.toml (picks up port/URL changes without restart)
                SettingRow { label: "Config";
                    HorizontalLayout {
                        x: 180px; spacing: 6px; padding: 4px;
                        FlatBtn {
                            label: "Reload";
                            active: false;
                            active-color: Theme.info; width: 120px;
                            clicked => { root.reload-config(); }
                        }
                        Text {
                            text: "~/.config/picam-rs/config.toml";
                            color: Theme.dim; font-size: 11px;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        // ── General tab ──
        if root.settings-tab == SettingsTab.General: Rectangle {
            x: 0; y: 56px; width: 800px; height: 364px;
            background: transparent;

            VerticalLayout {
                x: 0; width: 800px;
                spacing: 4px;
                padding-left: 10px; padding-right: 10px;

                // Self-timer
                SettingRow { label: "Self-Timer";
                    HorizontalLayout {
                        x: 180px; spacing: 6px; padding: 4px;
                        for lbl[i] in ["Off", "2s", "5s", "10s"]: FlatBtn {
                            label: lbl; active: root.self-timer-idx == i; width: 90px;
                            active-color: Theme.info;
                            clicked => { root.self-timer-idx = i; }
                        }
                    }
                }

                // Burst count
                SettingRow { label: "Burst";
                    HorizontalLayout {
                        x: 180px; spacing: 6px; padding: 4px;
                        for lbl[i] in ["1", "3", "5", "10"]: FlatBtn {
                            label: lbl; active: root.burst-count-idx == i; width: 90px;
                            active-color: Theme.info;
                            clicked => { root.burst-count-idx = i; }
                        }
                    }
                }

                // Last-shot review toggle
                SettingRow { label: "Last-Shot Review";
                    HorizontalLayout {
                        x: 180px; spacing: 6px; padding: 4px;
                        FlatBtn {
                            label: "ON"; active: root.last-shot-enabled;
                            active-color: Theme.info; width: 80px;
                            clicked => { root.last-shot-enabled = true; }
                        }
                        FlatBtn {
                            label: "OFF"; active: !root.last-shot-enabled;
                            active-color: Theme.warn; width: 80px;
                            clicked => { root.last-shot-enabled = false; }
                        }
                    }
                }

                // Screen sleep timeout — any tap on the dark screen wakes
                SettingRow { label: "Sleep Timeout";
                    HorizontalLayout {
                        x: 180px; spacing: 6px; padding: 4px;
                        for lbl[i] in ["Off", "30s", "1m", "5m", "10m", "30m"]: FlatBtn {
                            label: lbl; active: root.sleep-timeout-idx == i; width: 70px;
                            active-color: Theme.info;
                            clicked => { root.sleep-timeout-idx = i; }
                        }
                    }
                }

                // Storage info (read-only)
                SettingRow { label: "Storage Free";
                    Text {
                        x: 180px; y: 0; height: parent.height;
                        text: root.free-space-str;
                        color: Theme.text; font-size: 16px; font-weight: 700;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }

    // ·· Gallery ··
    if current-page == Page.Gallery: Rectangle {
        x: 0; y: 0; width: 800px; height: 420px;
        background: Theme.bg;

        Text {
            x: 16px; y: 12px;
            text: "Gallery (" + root.gallery-items.length + ")";
            color: Theme.text; font-size: 18px; font-weight: 700;
        }

        if root.gallery-items.length == 0: Text {
            x: 0; y: 0; width: 800px; height: 420px;
            text: "No photos or videos yet";
            color: Theme.dim; font-size: 16px;
            horizontal-alignment: center; vertical-alignment: center;
        }

        // Fullscreen selected item view
        if root.gallery-sel >= 0: Rectangle {
            background: #000000;

            // Image (photo) or thumbnail (video first frame)
            Image {
                x: 0; y: 64px;
                width: 800px; height: 356px;
                source: root.gallery-preview-image;
                image-fit: contain;
            }

            // Video play button — tapping it spawns mpv fullscreen for playback.
            if root.gallery-items[root.gallery-sel].is-video: TouchArea {
                mouse-cursor: none;
                x: 340px; y: 190px;
                width: 120px; height: 100px;
                Rectangle {
                    background: Theme.overlay;
                    border-radius: 10px;
                    border-width: 2px;
                    border-color: Theme.text;
                    Text {
                        text: "▶";
                        color: Theme.text; font-size: 56px; font-weight: 700;
                        horizontal-alignment: center; vertical-alignment: center;
                    }
                }
                clicked => {
                    root.play-video(root.gallery-items[root.gallery-sel].path);
                }
            }

            // Top bar: filename + Delete + Back
            Rectangle {
                x: 0; y: 0; width: 800px; height: 56px;
                background: Theme.overlay;
                Text {
                    text: root.gallery-items[root.gallery-sel].name;
                    color: Theme.text; font-size: 14px;
                    x: 16px; y: 0; height: parent.height;
                    vertical-alignment: center;
                }
                TouchArea {
                    mouse-cursor: none;
                    x: 696px; y: 4px; width: 96px; height: 48px;
                    Rectangle { background: Theme.accent; border-radius: 6px;
                        Text { text: "Delete"; color: Theme.text; font-size: 14px;
                               horizontal-alignment: center; vertical-alignment: center; } }
                    clicked => {
                        root.delete-item(root.gallery-sel);
                        root.gallery-sel = -1;
                    }
                }
                TouchArea {
                    mouse-cursor: none;
                    x: 592px; y: 4px; width: 96px; height: 48px;
                    Rectangle { background: Theme.surface; border-radius: 6px;
                        Text { text: "Back"; color: Theme.text; font-size: 14px;
                               horizontal-alignment: center; vertical-alignment: center; } }
                    clicked => { root.gallery-sel = -1; }
                }
            }
        }

        // Item list
        if root.gallery-sel < 0: ScrollView {
            x: 0; y: 44px; width: 800px; height: 376px;
            VerticalLayout {
                width: 780px;
                spacing: 2px;
                padding: 8px;
                for item[i] in root.gallery-items: TouchArea {
                mouse-cursor: none;
                    height: 52px;
                    Rectangle {
                        background: Theme.surface;
                        border-radius: 6px;
                        HorizontalLayout {
                            padding: 10px; spacing: 10px;
                            Text {
                                text: item.is-video ? "▶" : "◉";
                                font-size: 20px; color: Theme.dim;
                                vertical-alignment: center; width: 30px;
                                horizontal-alignment: center;
                            }
                            Text {
                                text: item.name;
                                color: Theme.text; font-size: 13px;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }
                        }
                    }
                    clicked => {
                        root.gallery-sel = i;
                        root.select-gallery-item(i);
                    }
                }
            }
        }
    }

    // ·· Power ··
    if current-page == Page.Power: Rectangle {
        x: 0; y: 0; width: 800px; height: 420px;
        background: Theme.bg;

        Text {
            x: 16px; y: 12px;
            text: "Power";
            color: Theme.text; font-size: 18px; font-weight: 700;
        }

        Text {
            x: 16px; y: 40px;
            text: "Hold for 1.5s to confirm — protects against stray taps during imaging.";
            color: Theme.dim; font-size: 12px;
        }

        VerticalLayout {
            x: 220px; y: 90px;
            width: 360px;
            spacing: 18px;

            shutdown-ta := TouchArea {
            mouse-cursor: none;
                height: 64px;
                Rectangle {
                    background: Theme.surface;
                    border-radius: 10px;
                    border-width: 2px;
                    border-color: Theme.accent;
                    // Progress fill while held
                    Rectangle {
                        x: 0; y: 0; height: parent.height;
                        width: shutdown-ta.pressed ? parent.width : 0px;
                        background: Theme.accent;
                        border-radius: 10px;
                        animate width { duration: 1500ms; easing: linear; }
                    }
                    Text { text: "⏻  Shut Down";
                           color: Theme.text; font-size: 18px; font-weight: 700;
                           horizontal-alignment: center; vertical-alignment: center; }
                }
                // Fire only after 1.5s hold; reset if released early
                Timer {
                    interval: 1500ms;
                    running: shutdown-ta.pressed;
                    triggered => { root.shutdown-system(); }
                }
            }

            reboot-ta := TouchArea {
            mouse-cursor: none;
                height: 64px;
                Rectangle {
                    background: Theme.surface;
                    border-radius: 10px;
                    border-width: 2px;
                    border-color: Theme.warn;
                    Rectangle {
                        x: 0; y: 0; height: parent.height;
                        width: reboot-ta.pressed ? parent.width : 0px;
                        background: Theme.warn;
                        border-radius: 10px;
                        animate width { duration: 1500ms; easing: linear; }
                    }
                    Text { text: "↺  Reboot";
                           color: Theme.text; font-size: 18px;
                           horizontal-alignment: center; vertical-alignment: center; }
                }
                Timer {
                    interval: 1500ms;
                    running: reboot-ta.pressed;
                    triggered => { root.reboot-system(); }
                }
            }

            // Restart App is cheap to recover from, so single-tap is fine.
            TouchArea {
                mouse-cursor: none;
                height: 56px;
                Rectangle {
                    background: Theme.info; border-radius: 10px;
                    Text { text: "⟳  Restart App";
                           color: Theme.text; font-size: 16px;
                           horizontal-alignment: center; vertical-alignment: center; }
                }
                clicked => { root.restart-app(); }
            }
        }
    }

    // ── Bottom navigation bar (always visible) ────────────────────────────────
    Rectangle {
        x: 0; y: 420px;
        width: 800px; height: 60px;
        background: #1e1e1e;

        HorizontalLayout {
            spacing: 0;
            alignment: center;

            NavBtn {
                icon:  "◉";
                label: "Camera";
                active: root.current-page == Page.Viewfinder;
                clicked => { root.current-page = Page.Viewfinder; }
            }
            NavBtn {
                icon:  "⚙";
                label: "Settings";
                active: root.current-page == Page.Settings;
                clicked => { root.current-page = Page.Settings; }
            }
            NavBtn {
                icon:  "▦";
                label: "Gallery";
                active: root.current-page == Page.Gallery;
                clicked => {
                    root.gallery-sel = -1;
                    root.refresh-gallery();
                    root.current-page = Page.Gallery;
                }
            }
            NavBtn {
                icon:  "⏻";
                label: "Power";
                active: root.current-page == Page.Power;
                clicked => { root.current-page = Page.Power; }
            }
        }
    }

    // ── Sleep overlay (top of z-order) ────────────────────────────────────────
    // Covers everything when Idle.sleeping; any tap on it dismisses sleep.
    if Idle.sleeping: Rectangle {
        x: 0; y: 0; width: 800px; height: 480px;
        background: #000000;
        TouchArea {
            mouse-cursor: none;
            width: 100%; height: 100%;
            clicked => { Idle.touch(); }
        }
    }
}
